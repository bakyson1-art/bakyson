# Bakyson Environment Variables
# Copy this file to .env and fill in your values

# Application
NODE_ENV=production
NEXT_PUBLIC_SITE_URL=https://bakyson-production.up.railway.app
NEXT_PUBLIC_APP_URL=https://bakyson-production.up.railway.app

# Database (Railway PostgreSQL)
# Railway provides DATABASE_URL automatically when you link the PostgreSQL service.
# The pg driver handles sslmode=require automatically from the URL.
DATABASE_URL="postgresql://user:password@host:5432/database?sslmode=require"

# Redis (Railway Redis - sessions, rate limiting, cache)
# Alternatively use Upstash: UPSTASH_REDIS_REST_URL + UPSTASH_REDIS_REST_TOKEN
REDIS_URL="redis://default:password@host:6379"
UPSTASH_REDIS_REST_URL="https://xxx.upstash.io"
UPSTASH_REDIS_REST_TOKEN="xxx"

# Authentication (NextAuth.js)
NEXTAUTH_SECRET="your-32-character-random-secret-here"
NEXTAUTH_URL=https://bakyson-production.up.railway.app

# Demo user credentials (replace with database-backed auth when PostgreSQL is provisioned)
BAKYSON_DEMO_EMAIL="demo@bakyson.com"
BAKYSON_DEMO_PASSWORD_HASH="$2b$12$P6N344oMoBAaK16d3iB7h.gvnCdzoX1oh1pDnHrTQ1qaf4cwh9PMG"

# Email (Resend)
RESEND_API_KEY="re_xxx"
SMTP_FROM="noreply@bakyson.com"
ADMIN_EMAIL="support@bakyson.com"

# File Storage (Cloudflare R2 / S3-compatible)
R2_ACCOUNT_ID="your-r2-account-id"
R2_ACCESS_KEY_ID="your-r2-access-key-id"
R2_SECRET_ACCESS_KEY="your-r2-secret-access-key"
R2_BUCKET_NAME="bakyson-assets"
R2_PUBLIC_URL="https://pub-xxx.r2.cloudflarestorage.com"

# Observability (Optional)
SENTRY_DSN="https://xxx@sentry.io/xxx"
NEXT_PUBLIC_SENTRY_DSN="https://xxx@sentry.io/xxx"
SENTRY_ORG="your-sentry-org"
SENTRY_PROJECT="bakyson"
NEXT_PUBLIC_ANALYTICS_ID="your-analytics-id"
